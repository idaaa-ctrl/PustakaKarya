    // ==================== LOGIKA MODAL SINOPSIS ====================
    function openSynopsisModal(bookId) {
      const book = EBOOKS.find((item) => item.id === bookId);
      if (!book) return;

      state.activeSynopsisId = book.id;

      document.getElementById('synopsisCategoryBadge').textContent = book.category;
      document.getElementById('synopsisFormatTag').textContent = book.format;
      document.getElementById('synopsisCoverTitle').textContent = book.title;
      document.getElementById('synopsisCoverAuthor').textContent = book.author;
      document.getElementById('synopsisCoverBox').className =
        `rounded-2xl p-5 bg-gradient-to-br ${book.gradient} text-white min-h-[230px] flex flex-col justify-between shadow-book`;

      document.getElementById('synopsisTitle').textContent = book.title;
      document.getElementById('synopsisAuthor').textContent = book.author;
      document.getElementById('synopsisRating').textContent = `★ ${book.rating.toFixed(1)} (${book.reviews} ulasan)`;
      document.getElementById('synopsisPages').textContent = `${book.pages} Halaman • ${book.format}`;
      document.getElementById('synopsisText').textContent = book.synopsis;
      document.getElementById('synopsisPrice').textContent = formatRupiah(book.price);

      document.getElementById('synopsisHighlights').innerHTML = book.highlights
        .map(
          (point) => `

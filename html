<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>PustakaKarya — Marketplace E-Book Pilihan &amp; Terkurasi</title>
  <!-- Memuat Tailwind CSS untuk tata letak responsif dan utilitas desain -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Memuat Google Fonts: Plus Jakarta Sans & Newsreader untuk nuansa editorial hangat -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            serif: ['"Newsreader"', 'Georgia', 'serif'],
          },
          colors: {
            canvas: '#FAF7F2',
            surface: '#FFFFFF',
            ink: '#1C1917',
            muted: '#57534E',
            terracotta: {
              DEFAULT: '#C2410C',
              hover: '#9A3412',
              soft: '#FFEDD5',
            },
            pine: {
              DEFAULT: '#14532D',
              soft: '#DCFCE7',
            },
          },
          boxShadow: {
            'editorial': '0 10px 30px -10px rgba(28, 25, 23, 0.08)',
            'book': '0 18px 35px -15px rgba(28, 25, 23, 0.22)',
          },
        },
      },
    };
  </script>

  <style>
    /* Transisi halus pada drawer, modal, dan toast notifikasi */
    .panel-backdrop {
      transition: opacity 0.25s ease, visibility 0.25s ease;
    }
    .drawer-panel {
      transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .modal-card {
      transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.25s ease;
    }
    /* Menyembunyikan scrollbar pada baris kategori di layar kecil namun tetap bisa di-scroll */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="bg-canvas text-ink font-sans antialiased selection:bg-terracotta-soft selection:text-terracotta">

  <!-- ==================== 1. NAVIGASI UTAMA ==================== -->
  <header class="sticky top-0 z-40 bg-canvas/90 backdrop-blur-md border-b border-stone-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Baris atas: Logo, Pencarian, dan Tombol Keranjang -->
      <div class="flex items-center justify-between gap-3 h-16 sm:h-20">
        <!-- Brand Logo -->
        <a href="#" class="flex items-center gap-2.5 group shrink-0">
          <div class="w-10 h-10 rounded-xl bg-terracotta text-white flex items-center justify-center shadow-sm group-hover:bg-terracotta-hover transition-colors">
            <!-- Ikon Buku SVG -->
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <div>
            <span class="font-serif font-semibold text-xl sm:text-2xl tracking-tight text-ink">PustakaKarya</span>
            <span class="hidden md:block text-[11px] uppercase tracking-widest text-muted font-semibold -mt-1">Toko E-Book Digital</span>
          </div>
        </a>

        <!-- Kolom Pencarian (Desktop & Tablet) -->
        <div class="hidden sm:flex flex-1 max-w-md mx-4">
          <div class="relative w-full">
            <span class="absolute inset-y-0 left-3.5 flex items-center text-stone-400 pointer-events-none">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
              </svg>
            </span>
            <input
              id="searchInputDesktop"
              type="text"
              placeholder="Cari judul e-book, penulis, atau topik..."
              aria-label="Cari judul e-book atau penulis"
              class="w-full pl-10 pr-9 py-2.5 text-sm bg-white border border-stone-200 rounded-xl text-ink placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-terracotta/30 focus:border-terracotta transition"
            />
            <button
              id="clearSearchDesktop"
              type="button"
              title="Hapus pencarian"
              class="hidden absolute inset-y-0 right-2.5 items-center text-stone-400 hover:text-ink px-1"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Aksi Kanan: Panduan GitHub & Tombol Keranjang -->
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <a
            href="#panduan-github"
            class="hidden lg:inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-muted hover:text-ink bg-white border border-stone-200 rounded-xl transition"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
            Panduan GitHub
          </a>

          <button
            id="openCartBtn"
            type="button"
            class="inline-flex items-center gap-2.5 px-3.5 sm:px-4 py-2.5 rounded-xl bg-ink text-white hover:bg-stone-800 active:scale-[0.99] transition shadow-sm font-semibold text-sm"
            aria-label="Buka keranjang belanja"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
            </svg>
            <span>Keranjang</span>
            <span id="cartBadge" class="inline-flex items-center justify-center min-w-[22px] h-[22px] px-1.5 text-xs font-bold rounded-full bg-terracotta text-white">
              0
            </span>
          </button>
        </div>
      </div>

      <!-- Kolom Pencarian Khusus Mobile -->
      <div class="sm:hidden pb-3">
        <div class="relative w-full">
          <span class="absolute inset-y-0 left-3.5 flex items-center text-stone-400 pointer-events-none">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m0 0A7.5 7.5 0 104.5 4.5a7.5 7.5 0 0012.15 12.15z" />
            </svg>
          </span>
          <input
            id="searchInputMobile"
            type="text"
            placeholder="Cari judul, penulis, atau topik..."
            aria-label="Cari judul e-book di perangkat mobile"
            class="w-full pl-10 pr-4 py-2.5 text-sm bg-white border border-stone-200 rounded-xl text-ink placeholder:text-stone-400 focus:outline-none focus:ring-2 focus:ring-terracotta/30 focus:border-terracotta"
          />
        </div>
      </div>

      <!-- Baris Filter Kategori -->
      <nav id="categoryPills" aria-label="Filter kategori e-book" class="flex items-center gap-2 py-2.5 overflow-x-auto no-scrollbar border-t border-stone-200/60">
        <!-- Diisi dinamis oleh JavaScript -->
      </nav>
    </div>
  </header>

  <!-- ==================== 2. HERO SECTION ==================== -->
  <section class="relative overflow-hidden pt-10 pb-14 sm:pt-14 sm:pb-20 border-b border-stone-200/70">
    <!-- Aksen dekoratif lembut -->
    <div class="pointer-events-none absolute -top-24 -right-24 w-96 h-96 rounded-full bg-terracotta/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-24 w-80 h-80 rounded-full bg-amber-500/10 blur-3xl"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- Konten Utama Hero -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-terracotta-soft text-terracotta text-xs font-bold tracking-wide uppercase">
            <span class="w-2 h-2 rounded-full bg-terracotta animate-pulse"></span>
            Siap Host di GitHub Pages &bull; Edisi Terkurasi
          </div>

          <h1 class="font-serif text-4xl sm:text-5xl lg:text-[3.4rem] font-semibold leading-[1.12] tracking-tight text-ink">
            Bangun wawasan &amp; karier lewat <span class="italic text-terracotta">e-book pilihan</span> yang praktis dibaca.
          </h1>

          <p class="text-base sm:text-lg text-muted leading-relaxed max-w-2xl">
            Temukan koleksi e-book berkualitas tinggi berbahasa Indonesia untuk bisnis, pengembangan diri, pemrograman, hingga fiksi bermakna. Dirancang agar pembaca dan klien Anda langsung jatuh cinta sejak halaman pertama.
          </p>

          <!-- Tombol CTA & Kode Promo -->
          <div class="flex flex-wrap items-center gap-3.5 pt-1">
            <a
              href="#katalog"
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-terracotta hover:bg-terracotta-hover text-white font-semibold text-sm sm:text-base shadow-md shadow-terracotta/20 transition active:scale-[0.99]"
            >
              <span>Jelajahi Katalog E-Book</span>
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>

            <button
              id="copyPromoBtn"
              type="button"
              class="inline-flex items-center gap-2 px-4 py-3.5 rounded-xl bg-white hover:bg-stone-50 text-ink border border-stone-200 font-semibold text-sm transition"
            >
              <span class="text-muted font-normal">Kode Promo:</span>
              <span class="font-mono font-bold text-terracotta">BACA10</span>
              <span class="text-xs px-2 py-0.5 rounded-md bg-pine-soft text-pine font-bold">-10%</span>
            </button>
          </div>

          <!-- 3 Nilai Utama (Value Propositions) -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-4">
            <div class="p-4 rounded-2xl bg-white/80 border border-stone-200/80 shadow-xs">
              <div class="w-9 h-9 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center mb-2.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h2 class="font-bold text-sm text-ink">Akses Digital Instan</h2>
              <p class="text-xs text-muted mt-1 leading-relaxed">Format EPUB &amp; PDF siap baca di HP, tablet, maupun laptop tanpa antre.</p>
            </div>

            <div class="p-4 rounded-2xl bg-white/80 border border-stone-200/80 shadow-xs">
              <div class="w-9 h-9 rounded-lg bg-emerald-100 text-emerald-800 flex items-center justify-center mb-2.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h2 class="font-bold text-sm text-ink">Judul Terkurasi Ketat</h2>
              <p class="text-xs text-muted mt-1 leading-relaxed">Materi aplikatif dari penulis dan praktisi berpengalaman di bidangnya.</p>
            </div>

            <div class="p-4 rounded-2xl bg-white/80 border border-stone-200/80 shadow-xs">
              <div class="w-9 h-9 rounded-lg bg-orange-100 text-orange-800 flex items-center justify-center mb-2.5">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <h2 class="font-bold text-sm text-ink">Harga Transparan &amp; Terjangkau</h2>
              <p class="text-xs text-muted mt-1 leading-relaxed">Mulai puluhan ribu Rupiah dengan potongan spesial menggunakan kode promo.</p>
            </div>
          </div>
        </div>

        <!-- Showcase Sampul Unggulan (Sisi Kanan Hero) -->
        <div class="lg:col-span-5">
          <div class="relative bg-white rounded-3xl p-5 sm:p-6 border border-stone-200/90 shadow-editorial">
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold uppercase tracking-wider text-muted">Pilihan Editor Minggu Ini</span>
              <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-amber-100 text-amber-900">&#9733; 4.9/5 Ulasan</span>
            </div>

            <!-- Tumpukan / Grid 2 Sampul Unggulan -->
            <div class="grid grid-cols-2 gap-4">
              <!-- Sampul 1 -->
              <div onclick="openSynopsisModal('eb-1')" class="cursor-pointer group rounded-2xl p-4 bg-gradient-to-br from-amber-900 via-stone-900 to-stone-950 text-white flex flex-col justify-between min-h-[230px] shadow-book transition-transform duration-300 group-hover:-translate-y-1">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded bg-white/15 text-amber-200">Bisnis</span>
                  <span class="text-[11px] text-stone-300">210 hlm</span>
                </div>
                <div class="my-4">
                  <div class="w-8 h-0.5 bg-amber-400 mb-2.5"></div>
                  <h3 class="font-serif text-lg leading-snug font-semibold">Arsitektur Bisnis Berkelanjutan</h3>
                  <p class="text-xs text-stone-300 mt-1">Raka Pradipta</p>
                </div>
                <div class="text-xs font-semibold text-amber-300 flex items-center justify-between pt-2 border-t border-white/10">
                  <span>Rp79.000</span>
                  <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
                </div>
              </div>

              <!-- Sampul 2 -->
              <div onclick="openSynopsisModal('eb-5')" class="cursor-pointer group rounded-2xl p-4 bg-gradient-to-br from-sky-900 via-indigo-950 to-slate-950 text-white flex flex-col justify-between min-h-[230px] shadow-book transition-transform duration-300 group-hover:-translate-y-1">
                <div class="flex items-center justify-between">
                  <span class="text-[10px] font-bold uppercase tracking-widest px-2 py-0.5 rounded bg-white/15 text-sky-200">Teknologi</span>
                  <span class="text-[11px] text-slate-300">285 hlm</span>
                </div>
                <div class="my-4">
                  <div class="w-8 h-0.5 bg-sky-400 mb-2.5"></div>
                  <h3 class="font-serif text-lg leading-snug font-semibold">Web Modern &amp; UI Presisi</h3>
                  <p class="text-xs text-slate-300 mt-1">Dimas Nusantara</p>
                </div>
                <div class="text-xs font-semibold text-sky-300 flex items-center justify-between pt-2 border-t border-white/10">
                  <span>Rp95.000</span>
                  <span class="group-hover:translate-x-0.5 transition-transform">&rarr;</span>
                </div>
              </div>
            </div>

            <div class="mt-4 pt-4 border-t border-stone-100 flex items-center justify-between text-xs text-muted">
              <span>Klik sampul untuk intip sinopsis &amp; daftar isi</span>
              <span class="font-semibold text-ink">PDF + EPUB</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 3. KATALOG E-BOOK ==================== -->
  <main id="katalog" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <!-- Header Katalog & Pengurutan -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-terracotta mb-1">Katalog Lengkap</p>
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold text-ink">Temukan Bacaan Berikutnya</h2>
        <p id="catalogSummary" class="text-sm text-muted mt-1">Menampilkan 8 e-book pilihan</p>
      </div>

      <div class="flex items-center gap-2.5">
        <label for="sortSelect" class="text-xs font-semibold text-muted shrink-0">Urutkan:</label>
        <select
          id="sortSelect"
          class="bg-white border border-stone-200 rounded-xl px-3.5 py-2.5 text-sm font-medium text-ink focus:outline-none focus:ring-2 focus:ring-terracotta/30 focus:border-terracotta"
        >
          <option value="featured">Terpopuler</option>
          <option value="rating">Rating Tertinggi</option>
          <option value="price-asc">Harga: Terendah ke Tertinggi</option>
          <option value="price-desc">Harga: Tertinggi ke Terendah</option>
        </select>
      </div>
    </div>

    <!-- Grid Kartu E-Book -->
    <div id="ebookGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <!-- Kartu e-book dirender oleh JavaScript -->
    </div>

    <!-- Tampilan Kosong Saat Pencarian/Filter Tidak Menemukan Hasil -->
    <div id="emptyState" class="hidden text-center py-16 px-4 bg-white rounded-3xl border border-stone-200/80 mt-4">
      <div class="w-14 h-14 rounded-2xl bg-stone-100 text-stone-500 flex items-center justify-center mx-auto mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <h3 class="font-serif text-2xl font-semibold text-ink">E-book tidak ditemukan</h3>
      <p class="text-sm text-muted max-w-md mx-auto mt-1.5">
        Coba gunakan kata kunci lain atau pilih kategori &ldquo;Semua&rdquo; untuk melihat seluruh koleksi e-book.
      </p>
      <button
        id="resetFilterBtn"
        type="button"
        class="mt-5 inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-terracotta hover:bg-terracotta-hover text-white text-sm font-semibold transition"
      >
        Reset Filter &amp; Pencarian
      </button>
    </div>
  </main>

  <!-- ==================== 5. PANDUAN DEPLOY & KUSTOMISASI GITHUB PAGES ==================== -->
  <section id="panduan-github" class="bg-white border-t border-stone-200/80 py-14 sm:py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-10">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-pine bg-pine-soft px-3 py-1 rounded-full mb-3">
          Panduan Untuk Pemilik Toko
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-semibold text-ink">
          Cara Deploy &amp; Kustomisasi di GitHub Pages
        </h2>
        <p class="text-sm sm:text-base text-muted mt-2 leading-relaxed">
          Seluruh tampilan toko ini berada dalam satu file <code class="px-1.5 py-0.5 rounded bg-stone-100 text-ink font-mono text-xs">index.html</code> tanpa butuh *server* rumit. Ikuti langkah berikut agar siap dipamerkan ke klien Anda:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-canvas border border-stone-200/80">
          <div class="w-8 h-8 rounded-full bg-ink text-white font-bold text-sm flex items-center justify-center mb-4">1</div>
          <h3 class="font-bold text-base text-ink mb-2">Unggah File ke Repository</h3>
          <p class="text-sm text-muted leading-relaxed">
            Buat repository baru di GitHub (misal <code class="font-mono text-xs bg-white px-1.5 py-0.5 rounded border">toko-ebook</code>), lalu unggah file ini dengan nama <code class="font-mono text-xs bg-white px-1.5 py-0.5 rounded border">index.html</code> ke cabang <code class="font-mono text-xs bg-white px-1.5 py-0.5 rounded border">main</code>.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-canvas border border-stone-200/80">
          <div class="w-8 h-8 rounded-full bg-ink text-white font-bold text-sm flex items-center justify-center mb-4">2</div>
          <h3 class="font-bold text-base text-ink mb-2">Aktifkan GitHub Pages</h3>
          <p class="text-sm text-muted leading-relaxed">
            Buka tab <strong>Settings &rarr; Pages</strong> pada repository Anda. Pada bagian <em>Build and deployment &rarr; Branch</em>, pilih <code class="font-mono text-xs bg-white px-1.5 py-0.5 rounded border">main</code> dan folder <code class="font-mono text-xs bg-white px-1.5 py-0.5 rounded border">/ (root)</code>, lalu klik <strong>Save</strong>.
          </p>
        </div>


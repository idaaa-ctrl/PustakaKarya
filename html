          </div>
        </div>
        <div class="pt-2 border-t border-stone-200">
          <span class="text-xs font-bold text-muted block mb-1">E-Book Dalam Simulasi Pesanan:</span>
          <ul class="text-xs text-stone-700 space-y-1">${purchasedTitles}</ul>

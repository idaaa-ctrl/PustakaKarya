    function closeSynopsisModal() {
      const backdrop = document.getElementById('synopsisModalBackdrop');
      const card = document.getElementById('synopsisModalCard');
      backdrop.classList.remove('visible', 'opacity-100');
      backdrop.classList.add('invisible', 'opacity-0');
      card.classList.remove('scale-100', 'opacity-100');
      card.classList.add('scale-95', 'opacity-0');
      state.activeSynopsisId = null;
    }

    // ==================== LOGIKA KERANJANG BELANJA ====================
    function addToCart(bookId) {
      const book = EBOOKS.find((item) => item.id === bookId);
      if (!book) return;

      const existing = state.cart.find((item) => item.id === bookId);
      if (existing) {
        existing.qty += 1;
      } else {
        state.cart.push({ id: bookId, qty: 1 });
      }

      renderCart();
      showToast(`"${book.title}" ditambahkan ke keranjang`);
    }

    function updateCartQty(bookId, delta) {
      const item = state.cart.find((entry) => entry.id === bookId);
      if (!item) return;

      item.qty += delta;
      if (item.qty <= 0) {
        state.cart = state.cart.filter((entry) => entry.id !== bookId);
      }
      renderCart();
    }

    function removeFromCart(bookId) {
      state.cart = state.cart.filter((entry) => entry.id !== bookId);
      renderCart();
    }

    function calculateCartTotals() {
      let subtotal = 0;
      let totalItems = 0;

      for (const entry of state.cart) {
        const book = EBOOKS.find((b) => b.id === entry.id);
        if (book) {
          subtotal += book.price * entry.qty;
          totalItems += entry.qty;
        }
      }

      const discountAmount = state.appliedPromo
        ? Math.round(subtotal * state.appliedPromo.discountRate)
        : 0;
      const total = Math.max(0, subtotal - discountAmount);

      return { subtotal, discountAmount, total, totalItems };
    }

    function renderCart() {
      const badge = document.getElementById('cartBadge');
      const subtitle = document.getElementById('cartItemSubtitle');
      const container = document.getElementById('cartItemsContainer');
      const subtotalEl = document.getElementById('cartSubtotal');
      const discountRow = document.getElementById('discountRow');
      const discountLabel = document.getElementById('discountLabel');
      const discountEl = document.getElementById('cartDiscount');
      const totalEl = document.getElementById('cartTotal');
      const checkoutBtn = document.getElementById('openCheckoutBtn');

      const { subtotal, discountAmount, total, totalItems } = calculateCartTotals();

      badge.textContent = totalItems;
      subtitle.textContent = totalItems === 0 ? 'Belum ada e-book dipilih' : `${totalItems} e-book dipilih`;
      checkoutBtn.disabled = state.cart.length === 0;

      if (state.cart.length === 0) {
        container.innerHTML = `
          <div class="h-full flex flex-col items-center justify-center text-center py-12 px-4">
            <div class="w-14 h-14 rounded-2xl bg-canvas border border-stone-200 flex items-center justify-center text-stone-400 mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
              </svg>
            </div>
            <p class="font-serif text-xl font-semibold text-ink">Keranjang masih kosong</p>
            <p class="text-xs text-muted mt-1 max-w-xs">
              Pilih e-book favorit Anda dari katalog untuk mulai menyusun daftar bacaan.
            </p>
          </div>
        `;
      } else {
        container.innerHTML = state.cart
          .map((entry) => {
            const book = EBOOKS.find((b) => b.id === entry.id);
            if (!book) return '';
            const lineTotal = book.price * entry.qty;

            return `
              <div class="flex gap-3.5 p-3.5 rounded-2xl bg-canvas border border-stone-200/80 items-center">
                <div class="w-14 h-20 rounded-xl bg-gradient-to-br ${book.gradient} text-white p-2 flex flex-col justify-end shrink-0 shadow-xs">
                  <span class="font-serif text-[10px] leading-tight line-clamp-2 font-semibold">${book.title}</span>
                </div>

                <div class="flex-1 min-w-0">
                  <div class="flex items-start justify-between gap-2">
                    <h4 class="font-bold text-sm text-ink truncate" title="${book.title}">${book.title}</h4>
                    <button
                      type="button"
                      onclick="removeFromCart('${book.id}')"
                      class="text-stone-400 hover:text-red-600 p-0.5 transition shrink-0"
                      title="Hapus item"
                      aria-label="Hapus ${book.title}"
                    >
                      <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                  <p class="text-xs text-muted">${book.author}</p>

                  <div class="flex items-center justify-between mt-2.5">
                    <div class="inline-flex items-center rounded-lg bg-white border border-stone-200">
                      <button
                        type="button"
                        onclick="updateCartQty('${book.id}', -1)"
                        class="w-7 h-7 flex items-center justify-center text-ink hover:bg-stone-100 rounded-l-lg font-bold text-sm"
                        aria-label="Kurangi jumlah"
                      >
                        &minus;
                      </button>
                      <span class="px-2.5 text-xs font-bold text-ink">${entry.qty}</span>
                      <button
                        type="button"
                        onclick="updateCartQty('${book.id}', 1)"
                        class="w-7 h-7 flex items-center justify-center text-ink hover:bg-stone-100 rounded-r-lg font-bold text-sm"
                        aria-label="Tambah jumlah"
                      >
                        +
                      </button>
                    </div>

                    <span class="text-sm font-extrabold text-ink">${formatRupiah(lineTotal)}</span>
                  </div>
                </div>
              </div>
            `;
          })
          .join('');
      }

      subtotalEl.textContent = formatRupiah(subtotal);

      if (state.appliedPromo && discountAmount > 0) {
        discountRow.classList.remove('hidden');
        discountRow.classList.add('flex');
        discountLabel.textContent = state.appliedPromo.label;
        discountEl.textContent = `-${formatRupiah(discountAmount)}`;
      } else {
        discountRow.classList.add('hidden');
        discountRow.classList.remove('flex');
      }

      totalEl.textContent = formatRupiah(total);
    }

    function openCartDrawer() {
      const backdrop = document.getElementById('cartBackdrop');
      const drawer = document.getElementById('cartDrawer');
      backdrop.classList.remove('invisible', 'opacity-0');
      backdrop.classList.add('visible', 'opacity-100');
      drawer.classList.remove('translate-x-full');
      drawer.classList.add('translate-x-0');
    }

    function closeCartDrawer() {
      const backdrop = document.getElementById('cartBackdrop');
      const drawer = document.getElementById('cartDrawer');
      backdrop.classList.remove('visible', 'opacity-100');
      backdrop.classList.add('invisible', 'opacity-0');
      drawer.classList.remove('translate-x-0');
      drawer.classList.add('translate-x-full');
    }

    // Terapkan kode promo
    function handleApplyPromo() {
      const input = document.getElementById('promoInput');
      const feedback = document.getElementById('promoFeedback');
      const code = input.value.trim().toUpperCase();

      feedback.classList.remove('hidden', 'text-pine', 'text-red-600');

      if (!code) {
        state.appliedPromo = null;
        feedback.textContent = 'Masukkan kode promo terlebih dahulu (contoh: BACA10).';
        feedback.classList.add('text-red-600');
        renderCart();
        return;
      }

      if (PROMO_CODES[code]) {
        state.appliedPromo = { code, ...PROMO_CODES[code] };
        feedback.textContent = `Kode ${code} aktif! Potongan 10% diterapkan pada subtotal.`;
        feedback.classList.add('text-pine');
        renderCart();
        showToast(`Kode promo ${code} berhasil digunakan`);
      } else {
        state.appliedPromo = null;
        feedback.textContent = `Kode "${code}" tidak valid. Coba gunakan BACA10.`;
        feedback.classList.add('text-red-600');
        renderCart();
      }
    }

    // ==================== LOGIKA SIMULASI CHECKOUT ====================
    function openCheckoutModal() {
      if (state.cart.length === 0) return;

      closeCartDrawer();

      const { subtotal, discountAmount, total } = calculateCartTotals();
      const preSummary = document.getElementById('checkoutPreSummary');

      const itemLines = state.cart
        .map((entry) => {
          const book = EBOOKS.find((b) => b.id === entry.id);
          return `<div class="flex justify-between text-xs text-stone-700">
            <span>${book.title} &times; ${entry.qty}</span>
            <span class="font-semibold">${formatRupiah(book.price * entry.qty)}</span>
          </div>`;
        })
        .join('');

      preSummary.innerHTML = `
        <div class="font-bold text-xs uppercase tracking-wider text-muted mb-1">Ringkasan Item</div>
        ${itemLines}
        <div class="pt-2 border-t border-stone-200 flex justify-between text-xs text-muted">
          <span>Subtotal</span>
          <span>${formatRupiah(subtotal)}</span>
        </div>
        ${
          discountAmount > 0
            ? `<div class="flex justify-between text-xs text-pine font-semibold">
                <span>Diskon (${state.appliedPromo.code})</span>
                <span>-${formatRupiah(discountAmount)}</span>
              </div>`
            : ''
        }
        <div class="pt-1.5 border-t border-stone-200 flex justify-between font-extrabold text-sm text-ink">
          <span>Total Simulasi</span>
          <span class="text-terracotta">${formatRupiah(total)}</span>
        </div>
      `;

      // Reset tampilan form vs sukses
      document.getElementById('checkoutForm').classList.remove('hidden');
      document.getElementById('checkoutSuccessBox').classList.add('hidden');

      const backdrop = document.getElementById('checkoutModalBackdrop');
      const card = document.getElementById('checkoutModalCard');
      backdrop.classList.remove('invisible', 'opacity-0');
      backdrop.classList.add('visible', 'opacity-100');
      card.classList.remove('scale-95', 'opacity-0');
      card.classList.add('scale-100', 'opacity-100');
    }

    function closeCheckoutModal() {
      const backdrop = document.getElementById('checkoutModalBackdrop');
      const card = document.getElementById('checkoutModalCard');
      backdrop.classList.remove('visible', 'opacity-100');
      backdrop.classList.add('invisible', 'opacity-0');
      card.classList.remove('scale-100', 'opacity-100');
      card.classList.add('scale-95', 'opacity-0');
    }


    // Sinkronisasi pencarian desktop & mobile
    function handleSearchInput(value) {
      state.searchQuery = value;
      const desktopInput = document.getElementById('searchInputDesktop');
      const mobileInput = document.getElementById('searchInputMobile');
      const clearBtn = document.getElementById('clearSearchDesktop');

      if (desktopInput.value !== value) desktopInput.value = value;
      if (mobileInput.value !== value) mobileInput.value = value;

      if (value.trim().length > 0) {
        clearBtn.classList.remove('hidden');
        clearBtn.classList.add('flex');
      } else {
        clearBtn.classList.add('hidden');
        clearBtn.classList.remove('flex');
      }

      renderCatalog();
    }

    // Inisialisasi event listener
    document.addEventListener('DOMContentLoaded', () => {
      renderCategoryPills();
      renderCatalog();
      renderCart();

      // Pencarian
      document.getElementById('searchInputDesktop').addEventListener('input', (e) => {
        handleSearchInput(e.target.value);
      });
      document.getElementById('searchInputMobile').addEventListener('input', (e) => {
        handleSearchInput(e.target.value);
      });
      document.getElementById('clearSearchDesktop').addEventListener('click', () => {
        handleSearchInput('');
      });

      // Reset filter saat kosong
      document.getElementById('resetFilterBtn').addEventListener('click', () => {
        state.selectedCategory = 'Semua';
        state.sortBy = 'featured';
        document.getElementById('sortSelect').value = 'featured';
        handleSearchInput('');
        renderCategoryPills();
      });

      // Pengurutan
      document.getElementById('sortSelect').addEventListener('change', (e) => {
        state.sortBy = e.target.value;
        renderCatalog();
      });

      // Salin kode promo BACA10
      document.getElementById('copyPromoBtn').addEventListener('click', () => {
        const tempInput = document.createElement('input');
        tempInput.value = 'BACA10';
        document.body.appendChild(tempInput);
        tempInput.select();
        document.execCommand('copy');
        document.body.removeChild(tempInput);

        document.getElementById('promoInput').value = 'BACA10';
        showToast('Kode promo BACA10 disalin ke clipboard');
      });

      // Modal Sinopsis
      document.getElementById('closeSynopsisBtn').addEventListener('click', closeSynopsisModal);
      document.getElementById('synopsisModalBackdrop').addEventListener('click', (e) => {
        if (e.target.id === 'synopsisModalBackdrop') closeSynopsisModal();
      });
      document.getElementById('synopsisAddToCartBtn').addEventListener('click', () => {
        if (state.activeSynopsisId) {
          addToCart(state.activeSynopsisId);
          closeSynopsisModal();
        }
      });

      // Drawer Keranjang
      document.getElementById('openCartBtn').addEventListener('click', openCartDrawer);
      document.getElementById('closeCartBtn').addEventListener('click', closeCartDrawer);
      document.getElementById('cartBackdrop').addEventListener('click', (e) => {
        if (e.target.id === 'cartBackdrop') closeCartDrawer();
      });
      document.getElementById('applyPromoBtn').addEventListener('click', handleApplyPromo);
      document.getElementById('promoInput').addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          e.preventDefault();
          handleApplyPromo();
        }
      });

      // Modal Checkout
      document.getElementById('openCheckoutBtn').addEventListener('click', openCheckoutModal);
      document.getElementById('closeCheckoutBtn').addEventListener('click', closeCheckoutModal);
      document.getElementById('checkoutModalBackdrop').addEventListener('click', (e) => {
        if (e.target.id === 'checkoutModalBackdrop') closeCheckoutModal();
      });
      document.getElementById('checkoutForm').addEventListener('submit', handleCheckoutSubmit);
      document.getElementById('finishCheckoutBtn').addEventListener('click', () => {
        closeCheckoutModal();
        document.getElementById('checkoutForm').reset();
      });

      // Tutup modal/drawer dengan tombol Escape
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
          closeSynopsisModal();
          closeCartDrawer();
          closeCheckoutModal();
        }
      });
    });
  </script>
</body>
</html>

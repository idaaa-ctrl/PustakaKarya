      appliedPromo: null, // { code, discountRate, label }
      activeSynopsisId: null,
    };

    // Helper format Rupiah Indonesia
    function formatRupiah(amount) {
      return new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR',
        minimumFractionDigits: 0,
        maximumFractionDigits: 0,
      }).format(amount);
    }

    // Helper notifikasi toast (pengganti alert)
    let toastTimeout = null;
    function showToast(message) {
      const toastEl = document.getElementById('toastNotification');
      const msgEl = document.getElementById('toastMessage');
      msgEl.textContent = message;

      toastEl.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
      toastEl.classList.add('opacity-100', 'translate-y-0');

      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toastEl.classList.remove('opacity-100', 'translate-y-0');
        toastEl.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
      }, 2600);
    }

    // Render tombol filter kategori
    function renderCategoryPills() {
      const container = document.getElementById('categoryPills');
      container.innerHTML = CATEGORIES.map((category) => {
        const isActive = state.selectedCategory === category;
        return `
          <button
            type="button"
            data-category="${category}"
            class="category-pill shrink-0 px-4 py-1.5 rounded-full text-xs sm:text-sm font-semibold transition ${
              isActive
                ? 'bg-terracotta text-white shadow-xs'
                : 'bg-white text-muted hover:text-ink hover:bg-stone-100 border border-stone-200/80'
            }"
          >
            ${category}
          </button>
        `;
      }).join('');

      container.querySelectorAll('.category-pill').forEach((btn) => {
        btn.addEventListener('click', () => {
          state.selectedCategory = btn.dataset.category;
          renderCategoryPills();
          renderCatalog();
        });
      });
    }

    // Menyaring dan mengurutkan daftar e-book
    function getFilteredEbooks() {
      const query = state.searchQuery.trim().toLowerCase();

      const filtered = EBOOKS.filter((book) => {
        const matchesCategory =
          state.selectedCategory === 'Semua' || book.category === state.selectedCategory;
        const matchesQuery =
          !query ||
          book.title.toLowerCase().includes(query) ||
          book.author.toLowerCase().includes(query) ||
          book.category.toLowerCase().includes(query);
        return matchesCategory && matchesQuery;
      });

      const sorted = [...filtered];
      if (state.sortBy === 'price-asc') {
        sorted.sort((a, b) => a.price - b.price);
      } else if (state.sortBy === 'price-desc') {
        sorted.sort((a, b) => b.price - a.price);
      } else if (state.sortBy === 'rating') {
        sorted.sort((a, b) => b.rating - a.rating || b.reviews - a.reviews);
      }
      return sorted;
    }

